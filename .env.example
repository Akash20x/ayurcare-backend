# Application runtime and browser origin allowed by CORS.
NODE_ENV=YOUR_NODE_ENV
ALLOWED_ORIGIN=YOUR_ALLOWED_ORIGIN

# MongoDB connection string used by Prisma.
DATABASE_URL=YOUR_DATABASE_URL

# Use long, random values in every deployed environment.
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET
ADMIN_SECRET=YOUR_ADMIN_SECRET

# Upstash Redis REST credentials used for sessions, OTPs, drafts, and caches.
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Enables the hourly expired-slot-lock cleanup job when set to true.
ENABLE_LOCK_CLEANUP=YOUR_ENABLE_LOCK_CLEANUP

# Set to true only after the EmailJS account and both templates are configured.
EMAILJS_ENABLED=YOUR_EMAILJS_ENABLED
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_EMAILJS_PRIVATE_KEY
EMAILJS_OTP_TEMPLATE_ID=YOUR_EMAILJS_OTP_TEMPLATE_ID
EMAILJS_APPOINTMENT_TEMPLATE_ID=YOUR_EMAILJS_APPOINTMENT_TEMPLATE_ID

# Used by the upcoming OTP flow for showcase mode. Keep the real value private.
MASTER_OTP=YOUR_MASTER_OTP

# Appointment OTP settings
OTP_EXPIRY_SECONDS=YOUR_OTP_EXPIRY_SECONDS
OTP_RESEND_COOLDOWN_SECONDS=YOUR_OTP_RESEND_COOLDOWN_SECONDS

# Google OAuth 2.0 Web application client ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
